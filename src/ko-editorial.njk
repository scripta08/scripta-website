---
layout: inner.njk
lang: ko
title: "편집위원회"
permalink: /scripta/editorial-board/
---
{%- set E = society.editorial_board -%}
<p style="color:var(--muted);margin:-12px 0 24px">{{ i18n.ko.term }} {{ E.term }}</p>
<div class="people">
  <div class="role">편집위원장</div><div>{% for p in E.editors %}{{ p.name }} <span style="color:var(--muted)">· {{ p.affiliation }}</span>{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
  <div class="role">편집위원</div><div>{% for p in E.members %}{{ p.name }} <span style="color:var(--muted)">· {{ p.affiliation }}</span>{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
</div>
